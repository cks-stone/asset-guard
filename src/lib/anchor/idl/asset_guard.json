          "name": "handover",
          "docs": [
            "PDA: handover_{asset_id}_{from}_{to}"
          ],
          "writable": true
        },
        {
          "name": "from",
          "docs": [
            "기존 담당자 — 렌트비(rent) 지불 + create 서명"
          ],
          "writable": true,
          "signer": true
        },
        {
          "name": "to",
          "docs": [
            "`address = handover.to` 제약으로 정합성이 검증됨."
          ]
        },
        {
          "name": "system_program",
          "address": "11111111111111111111111111111111"
        }
