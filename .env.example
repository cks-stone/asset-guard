# ============================================
# ASSET-GUARD Environment Configuration
# 사내/렌탈 자산 인수인계 시스템
# DEV / PRD 전환은 NEXT_PUBLIC_SOLANA_NETWORK 기준
# ============================================

# --------------------------------------------
# 공통 / 환경 분기
# --------------------------------------------
# dev | prd
NEXT_PUBLIC_APP_ENV=dev

# --------------------------------------------
# Web3 — Solana (Phantom 로그인 + Anchor 인수인계)
# ---
# devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Helius RPC Endpoint (DEV: Devnet / PRD: Mainnet-Beta)
NEXT_PUBLIC_SOLANA_RPC_URL=
# M1에서 Anchor 프로그램 배포 후 발급되는 Program ID
NEXT_PUBLIC_ASSET_GUARD_PROGRAM_ID=5U6NZm5aNtzEeWEdzuZiciRbmFo8wLEzxBfcXnEjgkJ3

# --------------------------------------------
# Database — Supabase (M2에서 입력)
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side 전용 (RLS 우회, 절대 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------
# Email — Resend 공문 자동 발송 (M5에서 입력)
# --------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --------------------------------------------
# Admin / Webhook
# --------------------------------------------
# 운영자 전용 API 시크릿 — x-admin-secret 헤더
ADMIN_SECRET=
# 렌탈사 공문 메일 발송 트리거 웹훅 검증 시크릿
EMAIL_WEBHOOK_SECRET=